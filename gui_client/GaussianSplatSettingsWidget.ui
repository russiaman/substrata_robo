  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="lodBaseLabel">
       <property name="toolTip">
        <string>Grid-step growth factor between LoD tree levels, used when the tree is built (Spark's Tiny-LoD approach). Smaller = more levels, deeper tree, smoother LoD transitions, slower to build. Larger = fewer levels, faster to build, more visible &quot;popping&quot; between levels. Default 1.5.

REQUIRES CLIENT RELOAD (or re-adding the splat) to take effect - only affects trees built AFTER the change, not ones already built.</string>
       </property>
       <property name="text">
        <string>LoD base</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QDoubleSpinBox" name="lodBaseDoubleSpinBox">
       <property name="toolTip">
        <string>Grid-step growth factor between LoD tree levels, used when the tree is built (Spark's Tiny-LoD approach). Smaller = more levels, deeper tree, smoother LoD transitions, slower to build. Larger = fewer levels, faster to build, more visible &quot;popping&quot; between levels. Default 1.5.

REQUIRES CLIENT RELOAD (or re-adding the splat) to take effect - only affects trees built AFTER the change, not ones already built.</string>
       </property>
       <property name="decimals">
        <number>2</number>
       </property>
       <property name="minimum">
        <double>1.010000000000000</double>
       </property>
       <property name="maximum">
        <double>5.000000000000000</double>
       </property>
       <property name="singleStep">
