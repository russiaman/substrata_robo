         <string>Layer count that maps to solid blue.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1000000.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>1.000000000000000</double>
        </property>
        <property name="value">
         <double>2.000000000000000</double>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QDoubleSpinBox" name="overdrawRangeMaxDoubleSpinBox">
        <property name="toolTip">
         <string>Layer count that maps to solid red.</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1000000.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>1.000000000000000</double>
        </property>
        <property name="value">
         <double>100.000000000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="39" column="0" colspan="2">
    <layout class="QHBoxLayout" name="diagnosticButtonsHorizontalLayout">
     <item>
      <widget class="QPushButton" name="countInFrustumPushButton">
       <property name="text">
        <string>Count in frustum</string>
       </property>
       <property name="toolTip">
        <string>One-off count (not live) of splats that are both in the camera's current view frustum and pass the size clamp above (respecting Invert). If the clamp is disabled (0/0), counts every in-frustum splat.</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="frustumReportPushButton">
       <property name="text">
        <string>Frustum report</string>
       </property>
       <property name="toolTip">
        <string>One-off structure report (not live), written to the log: for every cloud in view, how much of the LoD tree is unfolded at this camera position, and for each drawn node why the traversal stopped there - converged, capped by density/depth/budget, or a leaf with nothing coarser above it. Also the trees' depth and branching, and the layer_density of what is being drawn. Runs a full traversal per cloud on the main thread, so expect a hitch on a large cloud.</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="saturationSnapshotsPushButton">
       <property name="text">
        <string>Saturation snapshots</string>
       </property>
       <property name="toolTip">
        <string>Diagnostic dump, not a rendering setting: writes the next frame's splat pass to disk as PNGs - the running composite, its coverage and what each slice alone added, plus every level of the saturation mask as it stood between slices. For looking at where the fill actually lands, layer by layer, and at how much of the mask survives being read conservatively. Needs the saturation gate on and more than one slice, since it is the gate's censuses being photographed; the press is ignored otherwise. The captured frame does a full-screen readback per slice, so it takes seconds and its timings mean nothing.</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item row="40" column="0" colspan="2">
