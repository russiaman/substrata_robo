<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GaussianSplatSettingsWidget</class>
 <widget class="QWidget" name="GaussianSplatSettingsWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>340</width>
    <height>440</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0">
    <widget class="QLabel" name="pixelScaleLimitLabel">
     <property name="text">
      <string>Pixel scale limit</string>
     </property>
     <property name="toolTip">
      <string>Traversal stops refining a node once its on-screen footprint is below this many pixels. Lower = more detail, more splats drawn. Applies live, on the next camera movement.</string>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QDoubleSpinBox" name="pixelScaleLimitDoubleSpinBox">
     <property name="toolTip">
      <string>Traversal stops refining a node once its on-screen footprint is below this many pixels. Lower = more detail, more splats drawn. Applies live, on the next camera movement.</string>
     </property>
     <property name="decimals">
      <number>2</number>
     </property>
     <property name="minimum">
      <double>0.10000000000000001</double>
     </property>
     <property name="maximum">
      <double>50.000000000000000</double>
     </property>
     <property name="singleStep">
      <double>0.10000000000000001</double>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="maxSplatsBudgetLabel">
     <property name="text">
      <string>Max splats budget</string>
     </property>
     <property name="toolTip">
      <string>Per-cloud cap on how many LoD tree nodes one traversal may select. If a cloud's diagnostics show "!WARNING! budget cap", this is limiting detail on that cloud even though pixel_scale_limit hasn't converged. Applies live, on the next camera movement.</string>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QSpinBox" name="maxSplatsBudgetSpinBox">
     <property name="toolTip">
      <string>Per-cloud cap on how many LoD tree nodes one traversal may select. If a cloud's diagnostics show "!WARNING! budget cap", this is limiting detail on that cloud even though pixel_scale_limit hasn't converged. Applies live, on the next camera movement.</string>
     </property>
     <property name="minimum">
      <number>1000</number>
     </property>
     <property name="maximum">
      <number>999999999</number>
     </property>
     <property name="singleStep">
      <number>100000</number>
     </property>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QLabel" name="resortMoveThresholdLabel">
     <property name="text">
      <string>Resort move threshold (m)</string>
     </property>
     <property name="toolTip">
      <string>How far the camera has to move (scaled by distance to the cloud) before a cloud's LoD frontier is re-traversed. Lower = frontier updates more often, at more CPU cost. Applies live, on the next camera movement.</string>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <widget class="QDoubleSpinBox" name="resortMoveThresholdDoubleSpinBox">
     <property name="toolTip">
      <string>How far the camera has to move (scaled by distance to the cloud) before a cloud's LoD frontier is re-traversed. Lower = frontier updates more often, at more CPU cost. Applies live, on the next camera movement.</string>
     </property>
     <property name="decimals">
      <number>2</number>
     </property>
     <property name="minimum">
      <double>0.01000000000000000</double>
     </property>
     <property name="maximum">
      <double>100.000000000000000</double>
     </property>
     <property name="singleStep">
      <double>0.01000000000000000</double>
     </property>
    </widget>
   </item>
   <item row="3" column="0">
    <widget class="QLabel" name="lodBaseLabel">
     <property name="text">
      <string>LoD base</string>
     </property>
     <property name="toolTip">
      <string>Voxel-grid growth factor between tree levels, used when a splat object's LoD tree is built (requires reloading/re-adding the splat object to take effect - doesn't affect already-built trees).</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QDoubleSpinBox" name="lodBaseDoubleSpinBox">
     <property name="toolTip">
      <string>Voxel-grid growth factor between tree levels, used when a splat object's LoD tree is built (requires reloading/re-adding the splat object to take effect - doesn't affect already-built trees).</string>
     </property>
     <property name="decimals">
      <number>2</number>
     </property>
     <property name="minimum">
      <double>1.01000000000000001</double>
     </property>
     <property name="maximum">
      <double>4.000000000000000</double>
     </property>
     <property name="singleStep">
      <double>0.10000000000000001</double>
     </property>
    </widget>
   </item>
   <item row="4" column="0" colspan="2">
    <widget class="QLabel" name="lodBaseNoteLabel">
     <property name="text">
      <string>(LoD base requires client reload / re-adding the splat object)</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item row="5" column="0">
    <widget class="QLabel" name="alphaCutoffLabel">
     <property name="text">
      <string>Alpha cutoff</string>
     </property>
     <property name="toolTip">
      <string>Per-splat quad radius is cut to exactly where its alpha decays to this value, instead of a fixed 3-sigma bound - lossless at the default (1/255 = 0.0039, matches the fragment shader's own discard), trims low-opacity splats' quads further above that (less overdraw, at the cost of their faintest edge). Applies live.</string>
     </property>
    </widget>
   </item>
   <item row="5" column="1">
    <widget class="QDoubleSpinBox" name="alphaCutoffDoubleSpinBox">
     <property name="toolTip">
      <string>Per-splat quad radius is cut to exactly where its alpha decays to this value, instead of a fixed 3-sigma bound - lossless at the default (1/255 = 0.0039, matches the fragment shader's own discard), trims low-opacity splats' quads further above that (less overdraw, at the cost of their faintest edge). Applies live.</string>
     </property>
     <property name="decimals">
      <number>4</number>
     </property>
     <property name="minimum">
      <double>0.000100000000000</double>
     </property>
     <property name="maximum">
      <double>0.500000000000000</double>
     </property>
     <property name="singleStep">
      <double>0.001000000000000</double>
     </property>
     <property name="value">
      <double>0.003900000000000</double>
     </property>
    </widget>
   </item>
   <item row="6" column="0">
    <widget class="QLabel" name="sizeClampLabel">
     <property name="text">
      <string>Size clamp min/max (m)</string>
     </property>
     <property name="toolTip">
      <string>Debug tool for locating abnormally large/degenerate splats (e.g. under-reconstructed scene edges). Hides any splat whose feature size (2 x its largest scale axis, in metres) falls outside [min, max]. 0 disables that bound (same "0 = unlimited" convention as the Splats list search radius) - default (0, 0) has no effect. Applies live.</string>
     </property>
    </widget>
   </item>
   <item row="6" column="1">
    <widget class="QWidget" name="sizeClampWidget" native="true">
     <layout class="QHBoxLayout" name="sizeClampHorizontalLayout">
      <property name="leftMargin">
       <number>0</number>
      </property>
      <property name="topMargin">
       <number>0</number>
      </property>
      <property name="rightMargin">
       <number>0</number>
      </property>
      <property name="bottomMargin">
       <number>0</number>
      </property>
      <item>
       <widget class="QDoubleSpinBox" name="sizeClampMinDoubleSpinBox">
        <property name="toolTip">
         <string>Splats with feature size below this (metres) are hidden. Applies live. 0 = no lower cull.</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1000000.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.10000000000000001</double>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QDoubleSpinBox" name="sizeClampMaxDoubleSpinBox">
        <property name="toolTip">
         <string>Splats with feature size above this (metres) are hidden. Applies live. 0 (default) = no upper cull.</string>
        </property>
        <property name="decimals">
         <number>3</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1000000.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.10000000000000001</double>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="sizeClampInvertCheckBox">
        <property name="text">
         <string>Invert</string>
        </property>
        <property name="toolTip">
         <string>Unchecked (default): hide splats outside [min, max] - isolate a size range. Checked: hide splats inside [min, max] instead - exclude a size range, leaving the rest of the cloud untouched. No effect while both bounds are 0.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="7" column="0">
    <widget class="QPushButton" name="countInFrustumPushButton">
     <property name="text">
      <string>Count in frustum</string>
     </property>
     <property name="toolTip">
      <string>One-off count (not live) of splats that are both in the camera's current view frustum and pass the size clamp above (respecting Invert). If the clamp is disabled (0/0), counts every in-frustum splat.</string>
     </property>
    </widget>
   </item>
   <item row="7" column="1">
    <widget class="QLabel" name="countInFrustumResultLabel">
     <property name="text">
      <string></string>
     </property>
    </widget>
   </item>
   <item row="8" column="0" colspan="2">
    <widget class="QWidget" name="showOverdrawWidget" native="true">
     <layout class="QHBoxLayout" name="showOverdrawHorizontalLayout">
      <property name="leftMargin">
       <number>0</number>
      </property>
      <property name="topMargin">
       <number>0</number>
      </property>
      <property name="rightMargin">
       <number>0</number>
      </property>
      <property name="bottomMargin">
       <number>0</number>
      </property>
      <item>
       <widget class="QCheckBox" name="showOverdrawCheckBox">
        <property name="text">
         <string>Show overdraw (debug)</string>
        </property>
        <property name="toolTip">
         <string>Replaces splat colour with a flat additive red increment per surviving fragment, burning out brighter where many splats overlap on the same pixel - visualises depth complexity (blend layers per pixel) directly, which is what drives blend cost, rather than raw splat count. Applies live.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="overdrawSumAlphaCheckBox">
        <property name="text">
         <string>Sum alpha instead of layers</string>
        </property>
        <property name="toolTip">
         <string>Accumulates each fragment's alpha rather than a flat 1.0, so the ramp shows total accumulated alpha per pixel instead of a layer count (set the range below accordingly - alpha sums are far smaller numbers than layer counts). Read against the layer count from the same spot, this sizes up a front-to-back transmittance cutoff, the early-out a hardware blend pipeline cannot do per-fragment: the share of fragment work such a cutoff could skip is roughly (summed alpha) / 5.5. Hundreds of layers with a small alpha sum means near-threshold splats a cutoff would never reach - that case needs pruning, not early-out. No effect unless "Show overdraw" is ticked. Applies live.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="hideOverdrawCheckBox">
        <property name="text">
         <string>Hide overdraw</string>
        </property>
        <property name="toolTip">
         <string>Draws a counting pass first, then throws away every splat that lands where the layer count reached the overdraw range's maximum - exactly the region the overdraw view paints solid red - and draws what is left. The splats are dropped in the vertex shader, before rasterisation. Use it to check directly whether the red regions are where the time actually goes. Costs an extra full pass over the splats, so the frame total is meaningless while this is on: read the "draw splats" GPU timer, which is started after the counting pass and measures the same thing in both states. Switches the saturation gate off while it is on - they share the same mask.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="hideAlphaCheckBox">
        <property name="text">
         <string>Hide alpha</string>
        </property>
        <property name="toolTip">
         <string>The same diagnostic as "Hide overdraw", but the counting pass sums each fragment's alpha instead of counting fragments, so what is thrown away is the splats standing where a lot of alpha has piled up rather than where a lot of layers have. The two differ exactly where many faint layers overlap. Threshold is the same overdraw range maximum, read in alpha units - which are far smaller numbers than layer counts, so set the range accordingly. Ignored while "Hide overdraw" is ticked; only one mask exists.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="9" column="0">
    <widget class="QLabel" name="overdrawRangeLabel">
     <property name="text">
      <string>Overdraw range (layers)</string>
     </property>
     <property name="toolTip">
      <string>Layer-count range the overdraw ramp above maps to blue (min) .. green (midpoint) .. red (max). E.g. [2, 100]: pixels with 2 or fewer overlapping splats are solid blue, 100+ are solid red, in between fades smoothly. Applies live.</string>
     </property>
    </widget>
   </item>
   <item row="9" column="1">
    <widget class="QWidget" name="overdrawRangeWidget" native="true">
     <layout class="QHBoxLayout" name="overdrawRangeHorizontalLayout">
      <property name="leftMargin">
